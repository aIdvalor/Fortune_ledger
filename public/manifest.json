{
  "manifest_version": 3,
  "name": "Fortune Ledger",
  "version": "0.1.0",
  "description": "A little perspective before checkout.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fortune Ledger",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
